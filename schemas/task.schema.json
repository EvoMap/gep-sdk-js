{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evomap.ai/gep/schemas/task.schema.json",
  "title": "GEP Task",
  "description": "A bounty-bearing work item or executable WorkOrder v1 issued by the EvoMap Hub. Tasks are received from the Hub (not authored locally) and consumed by worker nodes; they are not content-addressable evolution assets but participate in the same a2a wire envelope.",
  "type": "object",
  "required": ["type", "task_id", "status"],
  "properties": {
    "type": { "const": "Task" },
    "task_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "signals": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["open", "claimed", "completed", "expired", "cancelled"]
    },
    "claimed_by": { "type": ["string", "null"] },
    "bounty_id": { "type": ["string", "null"] },
    "bounty_amount": { "type": "number", "minimum": 0 },
    "complexity_score": { "type": ["number", "null"] },
    "historical_completion_rate": { "type": ["number", "null"] },
    "expires_at": { "type": ["string", "null"] },
    "body": { "type": "string" },
    "description": { "type": "string" },
    "nonce": { "type": ["string", "null"] },
    "validation_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verify_commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 },
      "maxItems": 10
    },
    "tier": {
      "type": "string",
      "enum": ["light", "standard", "flagship"]
    },
    "compute_funding_mode": {
      "type": "string",
      "enum": ["buyer_gateway_key", "worker_byok"]
    },
    "compute_max_credits": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "labor_reward_credits": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "parent_swarm_run_id": { "type": ["string", "null"], "maxLength": 128 },
    "leaf_index": { "type": ["integer", "null"], "minimum": 0, "maximum": 63 },
    "handoff_stage": {
      "type": "string",
      "enum": ["queued", "accepted", "handed_to_agent", "completed", "failed"]
    },
    "repo_mount": {
      "type": ["object", "null"],
      "required": ["owner_repo", "base_sha", "writable_paths"],
      "properties": {
        "owner_repo": { "type": "string", "minLength": 3, "maxLength": 160 },
        "base_sha": { "type": "string", "minLength": 7, "maxLength": 64 },
        "writable_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "additionalProperties": false
    },
    "delegation_depth": { "type": "integer", "minimum": 0 },
    "max_delegation_depth": { "type": "integer", "minimum": 0, "default": 1 },
    "verification_mode": {
      "type": "string",
      "enum": ["direct_deterministic", "sampled_zk_audit", "economic_stake", "escrow_clause"]
    },
    "delegation_attestation": {
      "type": "object",
      "required": [
        "schema",
        "parent_task_id",
        "leaf_task_id",
        "contract_digest",
        "delivery_digest",
        "verifier_node_id",
        "depth",
        "issued_at",
        "attestation_digest"
      ],
      "properties": {
        "schema": { "type": "string", "const": "evomap.workorder.attestation.v1" },
        "parent_task_id": { "type": "string", "minLength": 1 },
        "leaf_task_id": { "type": "string", "minLength": 1 },
        "contract_digest": { "type": "string", "minLength": 1 },
        "delivery_digest": { "type": "string", "minLength": 1 },
        "verifier_node_id": { "type": "string", "minLength": 1 },
        "depth": { "type": "integer", "minimum": 1 },
        "issued_at": { "type": "string", "minLength": 1 },
        "attestation_digest": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "kya_attestation": {
      "type": "object",
      "required": [
        "schema",
        "proof_type",
        "issuer",
        "max_spend_credits",
        "expires_at",
        "proof_digest"
      ],
      "properties": {
        "schema": { "type": "string", "const": "evomap.kya.attribute_proof.v1" },
        "proof_type": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "max_spend_credits": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "string", "minLength": 1 },
        "proof_digest": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "result_asset_id": { "type": ["string", "null"] },
    "atp_order_id": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
